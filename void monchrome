end

-- [[ HOVER UTILITY ]] --
local function ApplySmoothHover(element, stroke, baseColor, hoverColor, baseTrans, hoverTrans)
    element.MouseEnter:Connect(function()
        TweenService:Create(element, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = hoverColor, BackgroundTransparency = hoverTrans}):Play()
    end)
    element.MouseLeave:Connect(function()
        TweenService:Create(element, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = baseColor, BackgroundTransparency = baseTrans}):Play()
    end)
end

