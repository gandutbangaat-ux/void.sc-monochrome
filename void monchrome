local function GetPlayerFromInput()
    local text = string.lower(TpInput.Text)
    text = string.gsub(text, "^%s*(.-)%s*$", "%1")
    if text ~= "" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (string.sub(string.lower(p.Name), 1, string.len(text)) == text or string.sub(string.lower(p.DisplayName), 1, string.len(text)) == text) then return p end
        end
    end
    return nil
end

local function GetClosestPlayerToCenter()
    local target = nil
    local dist = Config.FovRadius
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local targetPart = p.Character:FindFirstChild(Config.AimTarget)
            if targetPart then
                local pos, vis = Camera:WorldToViewportPoint(targetPart.Position)
                if vis then
                    local m = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if m < dist then dist = m target = targetPart end
                end
            end
        end
    end
    return target
end

