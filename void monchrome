-- [[ GAMEPLAY LOOP ]] --
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- 1. No Clip (Wallpass)
    if Config.NoClipActive and char then
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end

    FovCircle.Visible = Config.ShowFov
    if Config.ShowFov then
        FovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FovCircle.Radius = Config.FovRadius
    end

    -- Hitbox Expander
    local closestTarget = GetClosestPlayerToCenter()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            pcall(function()
                local head = p.Character.Head
                if Config.HitboxActive and closestTarget and (closestTarget.Name == "Head" and head == closestTarget or closestTarget.Name == "HumanoidRootPart" and head.Parent == closestTarget.Parent) then
                    head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.CanCollide = true
                end
            end)
        end
    end

    -- ESP Rendering
    for _, p in pairs(Players:GetPlayers()) do
        local objects = EspCache[p]
        if objects then
            local box = objects.Box
            local tracer = objects.Tracer
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local pHrp = p.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(pHrp.Position)
                if onScreen then
                    if Config.BoxEspActive then
                        local head = p.Character:FindFirstChild("Head")
                        local headPos = head and Camera:WorldToViewportPoint(head.Position) or pos
                        local boxHeight = math.abs(headPos.Y - pos.Y) * 3 local boxWidth = boxHeight / 1.5
                        box.Size = Vector2.new(boxWidth, boxHeight)
                        box.Position = Vector2.new(pos.X - boxWidth / 2, pos.Y - boxHeight / 2)
                        box.Visible = true
                    else box.Visible = false end
                    if Config.TracerActive then
                        tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tracer.To = Vector2.new(pos.X, pos.Y)
                        tracer.Visible = true
                    else tracer.Visible = false end
                else box.Visible = false tracer.Visible = false end
            else box.Visible = false tracer.Visible = false end
        end
    end

    -- Chams ESP
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("VoidESP")
            if Config.ChamsEspActive then
                if not hl then
                    hl = Instance.new("Highlight", p.Character) hl.Name = "VoidESP"
                    hl.FillColor = Color3.fromRGB(255, 255, 255) hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                end
            elseif hl then hl:Destroy() end
        end
    end

    -- Movement Physics
    if hrp and hum then
        if Config.SpeedActive and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Config.SpeedValue / 100))
        end
        if Config.JumpActive and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpValue, hrp.Velocity.Z)
        end
        
        local att = hrp:FindFirstChild("VoidFlyAtt")
        local lv = hrp:FindFirstChild("VoidFly")
        if Config.FlyActive then
            if not att then att = Instance.new("Attachment", hrp) att.Name = "VoidFlyAtt" end
            if not lv then lv = Instance.new("LinearVelocity", hrp) lv.Name = "VoidFly" lv.Attachment0 = att lv.MaxForce = math.huge end
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            lv.VectorVelocity = dir * Config.FlyValue
        else if lv then lv:Destroy() end if att then att:Destroy() end end
    end

    -- Aimbot Lock
    if Config.AimActive and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetClosestPlayerToCenter()
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
end)
