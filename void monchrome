local function CreateToggle(container, text, key, callback)
    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.new(0.98, 0, 0, 34)
    btn.BackgroundColor3 = Config[key] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(18, 18, 18)
    btn.BackgroundTransparency = Config[key] and 0.15 or 0.45
    btn.Text = "    " .. string.upper(text) .. (Config[key] and "    ✦   [ + ] ON" or "    ✦   [ - ] OFF")
    btn.TextColor3 = Config[key] and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(180, 180, 180)
    btn.Font = Enum.Font.MontserratBold
    btn.TextSize = 9
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Config[key] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
    btnStroke.Thickness = 1.2
    
    ApplySmoothHover(btn, btnStroke, Color3.fromRGB(18, 18, 18), Color3.fromRGB(30, 30, 30), 0.45, 0.3)

    btn.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        btn.Text = "    " .. string.upper(text) .. (Config[key] and "    ✦   [ + ] ON" or "    ✦   [ - ] OFF")
        
        local targetBg = Config[key] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(18, 18, 18)
        local targetText = Config[key] and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(180, 180, 180)
        
        TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetBg, BackgroundTransparency = Config[key] and 0.15 or 0.45, TextColor3 = targetText}):Play()
        btnStroke.Color = Config[key] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
        
        if callback then callback(Config[key]) end
    end)
end

