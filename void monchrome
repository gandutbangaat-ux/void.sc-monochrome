-- [[ GAMEPLAY LOOP ]] --
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if Config.StalkActive and StalkTargetPlayer and StalkTargetPlayer.Character and StalkTargetPlayer.Character:FindFirstChild("HumanoidRootPart") and hrp then
        pcall(function()
            local targetHrp = StalkTargetPlayer.Character.HumanoidRootPart
            hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3.5)
        end)
    end

    if Config.NoClipActive and char then
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end

    -- [[ REAL-TIME SPIN BOT TORNADO ENGINE ]] --
    if Config.SpinBotActive and hrp then
        pcall(function()
            -- Memutar paksa CFrame sumbu Y RootPart berdasarkan Config.SpinSpeed tanpa merusak movement WASD
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
        end)
    end

    local closestTarget = GetClosestPlayerToCenter()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            pcall(function()
                local head = p.Character.Head
                if Config.HitboxActive and closestTarget and (closestTarget.Name == "Head" and head == closestTarget or closestTarget.Name == "HumanoidRootPart" and head.Parent == closestTarget.Parent) then
                    head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize) head.Transparency = 0.5 head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1) head.Transparency = 0 head.CanCollide = true
                end
            end)
        end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            pcall(function()
                local hl = p.Character:FindFirstChild("VoidESP")
                if Config.ChamsEspActive then
                    if not hl then hl = Instance.new("Highlight", p.Character) hl.Name = "VoidESP" hl.FillColor = Color3.fromRGB(255, 255, 255) hl.OutlineColor = Color3.fromRGB(0, 0, 0) end
                elseif hl then hl:Destroy() end
            end)
        end
    end

    if hrp and hum then
        if Config.SpeedActive and hum.MoveDirection.Magnitude > 0 then hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Config.SpeedValue / 100)) end
        if Config.JumpActive and UserInputService:IsKeyDown(Enum.KeyCode.Space) then hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpValue, hrp.Velocity.Z) end
        
        local att = hrp:FindFirstChild("VoidFlyAtt") local lv = hrp:FindFirstChild("VoidFly")
        if Config.FlyActive then
            if not att then att = Instance.new("Attachment", hrp) att.Name = "VoidFlyAtt" end
            if not lv then lv = Instance.new("LinearVelocity", hrp) lv.Name = "VoidFly" lv.Attachment0 = att lv.MaxForce = math.huge end
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            lv.VectorVelocity = dir * Config.FlyValue
        else if lv then lv:Destroy() end if att then att:Destroy() end end
    end

    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetClosestPlayerToCenter()
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
end)

